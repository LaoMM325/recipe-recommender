# ===== 环境变量示例（复制为 .env 并填你自己的配置）=====
# 大模型（OpenAI 兼容服务均可；下方为项目演示默认值，可换成你用的服务）
LLM_API_KEY=在这里填你的API-KEY
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.5-flash

# 0 = 调真实大模型；1 = 不联网返回示例（联调用）
MOCK=0

# ---- AI 库外检索（可选：启用后“AI 再找几道”能搜全网真实菜谱）----
# 免费申请：https://app.tavily.com
TAVILY_API_KEY=tvly-在这里填你的Tavily-KEY
